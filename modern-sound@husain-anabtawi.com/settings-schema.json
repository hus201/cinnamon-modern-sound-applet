{
    "section-panel": {
        "type": "section",
        "description": "Panel"
    },
    "keyOpen": {
        "type": "keybinding",
        "default": "<Shift><Super>s",
        "description": "Open menu"
    },
    "middleClickAction": {
        "type": "combobox",
        "default": "mute",
        "options": {
            "Toggle Mute": "mute",
            "Toggle Mute output": "out_mute",
            "Toggle Mute input": "in_mute",
            "Toggle Play / Pause": "player"
        },
        "description": "Middle-click action"
    },
    "middleShiftClickAction": {
        "type": "combobox",
        "default": "in_mute",
        "options": {
            "Toggle Mute": "mute",
            "Toggle Mute output": "out_mute",
            "Toggle Mute input": "in_mute",
            "Toggle Play / Pause": "player"
        },
        "description": "Shift + middle-click action"
    },
    "section-sound": {
        "type": "section",
        "description": "Sound Change Effects"
    },
    "playVolumeChangeSound": {
        "type": "switch",
        "default": true,
        "description": "Play sound when changing output volume"
    },
    "showVolumeOsdOnScroll": {
        "type": "switch",
        "default": true,
        "description": "Show volume OSD when scrolling the panel icon"
    },
    "section-devices": {
        "type": "section",
        "description": "Devices"
    },
    "hideSingleOutputDevice": {
        "type": "switch",
        "default": false,
        "description": "Hide output device when only one is available"
    },
    "hideSingleInputDevice": {
        "type": "switch",
        "default": false,
        "description": "Hide input device when only one is available"
    }
}
