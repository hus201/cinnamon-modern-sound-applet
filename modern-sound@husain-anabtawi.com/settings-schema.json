{
    "section-panel": {
        "type": "section",
        "description": "Panel"
    },
    "keyOpen": {
        "type": "keybinding",
        "default": "<Shift><Super>s",
        "description": "Open menu"
    },
    "section-sound": {
        "type": "section",
        "description": "Sound"
    },
    "playVolumeChangeSound": {
        "type": "switch",
        "default": true,
        "description": "Play sound when changing output volume"
    },
    "section-devices": {
        "type": "section",
        "description": "Devices"
    },
    "hideSingleOutputDevice": {
        "type": "switch",
        "default": false,
        "description": "Hide output device when only one is available"
    },
    "hideSingleInputDevice": {
        "type": "switch",
        "default": false,
        "description": "Hide input device when only one is available"
    }
}
